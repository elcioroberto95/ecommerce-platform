# Copy to deploy.env on the server. Never commit the real file.
PUBLIC_APP_URL=http://YOUR_EC2_PUBLIC_IP:3001
PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:3000/api/v1

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecommerce:CHANGE_THIS_TO_A_LONG_RANDOM_VALUE@postgres:5432/ecommerce

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
LOG_LEVEL=info
